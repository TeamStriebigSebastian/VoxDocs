REPO voxdocs
LOAD voxdocs-local.yaml
ENTRY voxdocs/stack
ENV local
ENTRY local:voxdocs/stack
# Optional overrides (defaults are provided in voxdocs-local.yaml via fallback values)
SECRET db-password secret-key master-key cloudflare-api-token cloudflare-account-id
IMAGE voxdocs-backend:latest voxdocs/backend backend Dockerfile
IMAGE voxdocs-frontend:latest voxdocs/frontend frontend Dockerfile
