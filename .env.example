# VoxDocs Environment Configuration
# Copy this file to .env and update with your secure values

# ======================
# Security Settings
# ======================

# Secret key for JWT and session encryption (generate a strong random key)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Master encryption key for file encryption (must be 32+ characters)
MASTER_KEY=your-master-encryption-key-32-bytes!!

# ======================
# Application Settings
# ======================

# Enable debug mode (set to false in production)
DEBUG=false

# Frontend port mapping
FRONTEND_PORT=3000

# ======================
# Database Settings
# ======================

# SQLite database path (relative to data directory)
DATABASE_URL=sqlite+aiosqlite:///./data/voxdocs.db

# ======================
# Whisper Settings
# ======================

# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=small

# Processing device: cpu, cuda, auto
WHISPER_DEVICE=cpu

# Default language for transcription
WHISPER_LANGUAGE=de

# ======================
# Processing Settings
# ======================

# Hour for nightly batch processing (0-23)
BATCH_PROCESSING_HOUR=2

# Data retention period in days
RETENTION_DAYS=90

# Maximum audio duration in seconds
MAX_AUDIO_DURATION_SECONDS=3600

# ======================
# Optional: Redis (for Celery queue)
# ======================

# Uncomment to enable Redis-based queue
# USE_CELERY=true
# REDIS_URL=redis://redis:6379/0
