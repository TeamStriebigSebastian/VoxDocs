# VoxDocs Environment Configuration
# Copy this file to .env and update with your secure values
#
# IMPORTANT: All processing happens LOCALLY (GDPR/DSGVO compliant!)
# - Whisper: Local speech recognition (supports ALL languages!)
# - Ollama: Local LLM for translation and categorization
# - Piper TTS: Local text-to-speech with German Thorsten voice

# ======================
# Security Settings
# ======================

# Secret key for JWT and session encryption (generate a strong random key)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Master encryption key for file encryption (must be 32+ characters)
MASTER_KEY=your-master-encryption-key-32-bytes!!

# ======================
# Application Settings
# ======================

# Enable debug mode (set to false in production)
DEBUG=false

# Frontend port mapping
FRONTEND_PORT=3000

# ======================
# Database Settings
# ======================

# PostgreSQL (for nursing appointments with photos)
DB_PASSWORD=voxdocs_secure_password_change_in_production
DATABASE_URL=postgresql://voxdocs:${DB_PASSWORD}@db:5432/voxdocs

# ======================
# Whisper Settings (MULTILINGUAL!)
# ======================

# Whisper model size: tiny, base, small, medium (recommended), large-v2, large-v3
# Medium = best balance between speed and accuracy
WHISPER_MODEL=medium

# Processing device: cpu, cuda, auto
WHISPER_DEVICE=cpu

# IMPORTANT: Whisper transcribes in ANY language!
# Polish, Romanian, Turkish, Arabic, etc. - all supported
# The LLM will translate everything to German afterwards

# ======================
# LLM Settings (Ollama - LOCAL!)
# ======================

# Enable LLM correction and categorization
USE_LLM_CORRECTION=true

# LLM Provider: ollama (local, GDPR-compliant)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434

# Model to use (will auto-download on first use)
# Options: mistral (recommended), llama3.2, gemma2, qwen2.5
# Mistral ~4GB, good for nursing documentation
LLM_MODEL=mistral

# ======================
# TTS Settings (Piper - LOCAL!)
# ======================

# Piper executable (installed in Docker image)
PIPER_EXECUTABLE=piper

# Voice model: de_DE-thorsten-high (deep German male voice)
PIPER_VOICE_MODEL=/app/models/de_DE-thorsten-high

# TTS output directory
TTS_OUTPUT_DIR=/app/storage/tts

# ======================
# Processing Settings
# ======================

# Hour for nightly batch processing (0-23)
BATCH_PROCESSING_HOUR=2

# Data retention period in days
RETENTION_DAYS=90

# Maximum audio duration in seconds
MAX_AUDIO_DURATION_SECONDS=3600
